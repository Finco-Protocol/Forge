               "params" : {
                  "initialOwner" : "Administrative owner; only used to wire the factory once.",
                  "positionManager_" : "The canonical Uniswap V4 PositionManager for this chain."
               }
            },
            "lockPosition(address,uint256)" : {
               "details" : "Called once per launch by the factory, immediately after minting the full-range position directly to this locker's address."
            },
            "onERC721Received(address,address,uint256,bytes)" : {
               "details" : "Not part of the graduation path. Graduation names this locker as the `MINT_POSITION` owner, and the PositionManager mints with a plain `_mint`, which fires no receiver callback. Custody is established by the `ownerOf` check in `lockPosition` instead. This exists so the locker still behaves correctly under an explicit `safeTransferFrom`, and so such a transfer can only ever originate from the canonical PositionManager."
            },
            "owner()" : {
               "details" : "Returns the address of the current owner."
            },
            "pendingOwner()" : {
               "details" : "Returns the address of the pending owner."
            },
            "transferOwnership(address)" : {
               "details" : "Starts the ownership transfer of the contract to a new account. Replaces the pending transfer if there is one. Can only be called by the current owner. Setting `newOwner` to the zero address is allowed; this can be used to cancel an initiated ownership transfer."
            }
         },
         "title" : "RobinFunFiV2LaunchLocker",
         "version" : 1
      },
      "userdoc" : {
         "kind" : "user",
         "methods" : {
            "isLocked(address)" : {
               "notice" : "Returns whether a launch's position has been locked here."
            },
            "lockPosition(address,uint256)" : {
               "notice" : "Registers and verifies permanent custody of a graduated position."
            },
            "lockTokenSupply(address,uint256)" : {
               "notice" : "Permanently locks the virtual-reserve token remainder that cannot enter the graduated pool without lowering its opening price."
            },
            "onERC721Received(address,address,uint256,bytes)" : {
               "notice" : "Rejects safe transfers of anything but a canonical position NFT."
            },
            "renounceOwnership()" : {
               "notice" : "Permanently disabled. Ownership here exists only to perform the one-time factory wiring, and renouncing before that wiring would leave the locker unable to ever accept a graduated position."
            },
            "setFactory(address)" : {
               "notice" : "One-time wiring of the v2 factory, set after both are deployed."
            }
         },
         "notice" : "Permanently holds the graduated Uniswap V4 position NFT for every robinfun v2 launch. Unlike v1's locker, there is no `collectFees()` here: fee collection and distribution belong entirely to RobinFunFiV2MemeHook and RobinFunFiV2FeeEscrow, since a V4 position accrues fees inside the singleton PoolManager rather than on the NFT itself. This contract exposes no withdrawal or arbitrary-call function, so locked liquidity can never be removed by an administrator.",
         "version" : 1
      }
