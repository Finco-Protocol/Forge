# W02 local/test environment configuration example (NO SECRETS).
# Copy to .env (git-ignored) and fill in real values for a local Anvil run.
#
# forge script script/DeployForgeW02.s.sol --rpc-url http://127.0.0.1:8545 \
#   --broadcast --legacy

# Anvil default #1 (NEVER use in production).
FORGE_AUTHORITY_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# RPC endpoint for a LOCAL fork or local Anvil only. Production deployment
# is out of scope until W03+ independent review.
RPC_URL=http://127.0.0.1:8545
