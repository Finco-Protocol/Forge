# W06 staging environment (copy to .env.staging). TEST-ONLY VALUES: the staging guard refuses any private key that is
# not one of the ten well-known Anvil development keys, and refuses real GitHub / RPC hosts and production flags.
# Replace the passwords/secrets with fresh random values for any shared host; never reuse them anywhere else.
POSTGRES_PASSWORD=change-me-local-only
SESSION_SECRET=replace-with-64-hex-chars-from-openssl-rand-hex-32-xxxxxxxxxxxxxxxx
FORGE_OPS_TOKEN=replace-with-48-hex-chars-from-openssl-rand-hex-24-xxxxxxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=replace-with-32-chars-or-more-xxxxxxxxxxxxxxxx
# Anvil dev accounts #1 #3 #2 #4 (public test keys; the same roles as the sandbox deployment)
FORGE_AUTHORITY_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
FORGE_EVIDENCE_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
FORGE_RELAYER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
FORGE_REVENUE_ATTESTOR_PRIVATE_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a
