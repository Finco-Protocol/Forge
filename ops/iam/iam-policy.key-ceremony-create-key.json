{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateOnlyNonExportableSecp256k1SigningKeys",
      "Effect": "Allow",
      "Action": "kms:CreateKey",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:KeySpec": "ECC_SECG_P256K1",
          "kms:KeyUsage": "SIGN_VERIFY",
          "kms:KeyOrigin": [
            "AWS_KMS",
            "AWS_CLOUDHSM"
          ]
        },
        "Bool": {
          "kms:MultiRegion": "false",
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    },
    {
      "Sid": "NeverImportKeyMaterial",
      "Effect": "Deny",
      "Action": [
        "kms:ImportKeyMaterial",
        "kms:GetParametersForImport"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AliasesForForgeKeysOnly",
      "Effect": "Allow",
      "Action": [
        "kms:CreateAlias"
      ],
      "Resource": [
        "arn:aws:kms:<AWS_REGION>:<AWS_ACCOUNT_ID>:alias/forge-*",
        "arn:aws:kms:<AWS_REGION>:<AWS_ACCOUNT_ID>:key/*"
      ]
    }
  ]
}
