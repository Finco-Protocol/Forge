{
  "_comment": "Page on any key-management change to a Forge signing key, and on Sign calls from any principal other than that key's signer role (the key policy already denies them; this alerts on the attempt).",
  "Rules": [
    {
      "Name": "forge-kms-key-management-change",
      "EventPattern": {
        "source": [
          "aws.kms"
        ],
        "detail-type": [
          "AWS API Call via CloudTrail"
        ],
        "detail": {
          "eventName": [
            "PutKeyPolicy",
            "DisableKey",
            "EnableKey",
            "ScheduleKeyDeletion",
            "CancelKeyDeletion",
            "CreateGrant",
            "CreateAlias",
            "UpdateAlias",
            "DeleteAlias"
          ],
          "requestParameters": {
            "keyId": [
              "arn:aws:kms:<AWS_REGION>:<AWS_ACCOUNT_ID>:key/<FORGE_AUTHORITY_KEY_ID>",
              "arn:aws:kms:<AWS_REGION>:<AWS_ACCOUNT_ID>:key/<FORGE_EVIDENCE_KEY_ID>",
              "arn:aws:kms:<AWS_REGION>:<AWS_ACCOUNT_ID>:key/<FORGE_REVENUE_ATTESTOR_KEY_ID>"
            ]
          }
        }
      }
    },
    {
      "Name": "forge-kms-sign-denied",
      "EventPattern": {
        "source": [
          "aws.kms"
        ],
        "detail-type": [
          "AWS API Call via CloudTrail"
        ],
        "detail": {
          "eventName": [
            "Sign"
          ],
          "errorCode": [
            "AccessDeniedException"
          ]
        }
      }
    }
  ]
}
