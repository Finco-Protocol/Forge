# FINCO Forge W03 — environment template. NEVER commit real secrets.
# Copy to .env.local for `pnpm dev`. Sandbox (local Anvil) values shown.

# ── Network ───────────────────────────────────────────────────────────────
FORGE_NETWORK=sandbox                 # sandbox | robinhood (robinhood is PRODUCTION_BLOCKED and refused)
FORGE_CHAIN_ID=31337
FORGE_RPC_URL=http://127.0.0.1:8545
FORGE_DEPLOYMENT_FILE=.sandbox/deployment.json   # written by `pnpm sandbox:deploy`
FORGE_CONFIRMATIONS=0                 # finality depth for the indexer (use >= 20 on a real L2)
FORGE_PUBLIC_ORIGIN=http://localhost:3000

# ── Sessions ──────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-64-random-hex-chars-change-me-to-64-random-hex
SESSION_TTL_SECONDS=28800

# ── GitHub App (sandbox: produced by `pnpm sandbox:fake-github` in .sandbox/github.env)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=               # PEM; literal \n accepted
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# ── Eligibility policy ────────────────────────────────────────────────────
FORGE_ALLOW_PRIVATE_REPOS=false
FORGE_ALLOW_FORK_REPOS=false
FORGE_VERIFICATION_TTL_SECONDS=900
FORGE_BINDING_HORIZON_SECONDS=604800
FORGE_ATTESTATION_TTL_SECONDS=1800
FORGE_CONSENT_TTL_SECONDS=1200
FORGE_SIGNING_RATE_LIMIT_PER_HOUR=30

# ── Keys (local-test provider: ONLY accepted on chain 31337/1337) ─────────
# Use Anvil's public default dev keys for accounts #1 (authority), #3 (evidence), #2 (relayer)
# (printed by `anvil` on startup). They are refused on any chain but 31337/1337.
FORGE_SIGNER_PROVIDER=local-test
FORGE_AUTHORITY_PRIVATE_KEY=
FORGE_EVIDENCE_PRIVATE_KEY=
FORGE_RELAYER_PRIVATE_KEY=
# W04: revenue-splitter attestor (Anvil account #4). Optional; unset = no
# eligible-revenue ceilings are signed and splitter pulls fail closed.
FORGE_REVENUE_ATTESTOR_PRIVATE_KEY=

# ── Persistence & worker ──────────────────────────────────────────────────
# DATABASE_URL=postgres://forge:forge@localhost:5432/forge   # production
FORGE_PGLITE_DIR=.data/pglite         # sandbox: embedded Postgres (PGlite)
FORGE_EMBEDDED_WORKER=true            # sandbox only; production runs `pnpm worker`
FORGE_REVOCATION_SLO_SECONDS=300      # /api/health revocations.breached threshold
FORGE_TRUSTED_PROXY_HOPS=0            # proxies that APPEND X-Forwarded-For; 0 = never trust it

# ── Hard gates (must stay as-is in W03) ───────────────────────────────────
FINCO_BURN_ENABLED=false
