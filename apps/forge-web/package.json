{
  "name": "forge-web",
  "version": "0.3.0",
  "private": true,
  "description": "FINCO Forge W03 — verified builder launch platform (sandbox). Production blocked.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "abi:gen": "tsx scripts/gen-abis.ts",
    "abi:check": "tsx scripts/gen-abis.ts --check",
    "db:migrate": "tsx scripts/migrate.ts",
    "sandbox:deploy": "tsx scripts/deploy-sandbox.ts",
    "sandbox:fake-github": "tsx scripts/fake-github.ts",
    "worker": "tsx scripts/worker.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:fork": "vitest run --project fork",
    "test:pg": "vitest run --project pg",
    "ledger:rebuild": "tsx scripts/w05/ledger-admin.ts rebuild",
    "ledger:check": "tsx scripts/w05/ledger-admin.ts check",
    "bench:ledger": "tsx scripts/w05/bench-ledger.ts",
    "db:backup-rehearsal": "tsx scripts/w05/db-backup-rehearsal.ts",
    "size:check": "tsx scripts/size-gate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@tanstack/react-query": "5.104.2",
    "@wagmi/core": "2.22.1",
    "next": "15.5.27",
    "pg": "8.23.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "viem": "2.57.5",
    "wagmi": "2.19.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "1.56.1",
    "@safe-global/safe-smart-account": "1.5.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@uniswap/v4-core": "1.0.2",
    "@uniswap/v4-periphery": "1.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "postcss@<8.5.23": "8.5.23",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "uuid@<11.1.1": "^11.1.1"
    }
  }
}
